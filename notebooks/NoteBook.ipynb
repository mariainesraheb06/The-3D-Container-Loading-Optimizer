    "        \n",
    "        length = round(random.uniform(l_min, l_max), 1)\n",
    "        width = round(random.uniform(w_min, w_max), 1)\n",
    "        height = round(random.uniform(h_min, h_max), 1)\n",
    "        weight = round(random.uniform(0.5, 30), 2)\n",
    "        fragile = random.random() < 0.3  \n",
    "        \n",
    "        new_boxes.append({\n",
    "            'id': start_id + i,\n",
    "            'length': length,\n",
    "            'width': width,\n",
    "            'height': height,\n",
    "            'weight_kg': weight,\n",
    "            'fragile': fragile,\n",
